<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.buda.demografico.LoginController"
      spacing="20"
      alignment="CENTER"
      prefWidth="400" prefHeight="350"
      style="-fx-background-color: #f5f5f5;">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <!-- Logo/Título -->
    <VBox alignment="CENTER" spacing="5">
        <Label text="DemograficoBUDA" style="-fx-font-weight: bold; -fx-font-size: 24px; -fx-text-fill: #8b4513;"/>
        <Label text="Pesquisa Budista" style="-fx-font-size: 14px; -fx-text-fill: #666;"/>
    </VBox>

    <Separator prefWidth="350"/>

    <!-- Área de Login -->
    <VBox spacing="15" alignment="CENTER">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>
        <Label text="Identifique-se para começar" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>

        <!-- Nome de Usuário -->
        <VBox spacing="5">
            <Label text="Nome de Usuário:" style="-fx-font-size: 12px;"/>
            <TextField fx:id="nomeUsuarioField"
                      promptText="Digite seu nome de usuário"
                      prefWidth="300"
                      onAction="#onLogin"/>
        </VBox>

        <!-- Nome Completo (para registro) -->
        <VBox spacing="5" fx:id="novoUsuarioBox" visible="false" managed="false">
            <Label text="Nome Completo:" style="-fx-font-size: 12px;"/>
            <TextField fx:id="nomeCompletoField"
                      promptText="Digite seu nome completo"
                      prefWidth="300"/>
        </VBox>

        <!-- Email (opcional) -->
        <VBox spacing="5" fx:id="emailBox" visible="false" managed="false">
            <Label text="Email (opcional):" style="-fx-font-size: 12px;"/>
            <TextField fx:id="emailField"
                      promptText="Digite seu email"
                      prefWidth="300"/>
        </VBox>

        <!-- Botões -->
        <HBox spacing="10" alignment="CENTER">
            <padding>
                <Insets top="10"/>
            </padding>
            <Button fx:id="loginButton"
                   text="Entrar"
                   onAction="#onLogin"
                   styleClass="primary-button"
                   maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Button fx:id="novoUsuarioButton"
                   text="Novo Usuário"
                   onAction="#onToggleNovoUsuario"
                   styleClass="button-default"
                   maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
        </HBox>

        <!-- Mensagem de Status -->
        <Label fx:id="mensagemLabel" text="" style="-fx-text-fill: red; -fx-font-size: 11px;"/>
    </VBox>

    <!-- Restaurar Sessão -->
    <HBox alignment="CENTER" spacing="5">
        <padding>
            <Insets top="10"/>
        </padding>
        <Label fx:id="ultimoUsuarioLabel" text="" style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
    </HBox>

</VBox>

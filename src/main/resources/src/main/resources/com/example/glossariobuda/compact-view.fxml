<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox styleClass="compact-background" stylesheets="@glossario-styles.css" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.glossariobuda.CompactViewController" spacing="5.0" prefWidth="320.0">
   <padding>
      <Insets top="8.0" right="8.0" bottom="8.0" left="8.0" />
   </padding>

   <children>
      <!-- Header with title and buttons -->
      <HBox alignment="CENTER_LEFT" spacing="5.0">
         <children>
            <Label text="🕉 Glossário" styleClass="compact-title" HBox.hgrow="ALWAYS" />
            <Button fx:id="addButton" text="+" onAction="#showAddTermDialog" styleClass="compact-button">
               <tooltip>
                  <Tooltip text="Adicionar novo termo" />
               </tooltip>
            </Button>
            <Button fx:id="expandButton" text="⛶" onAction="#expandToFullView" styleClass="compact-button">
               <tooltip>
                  <Tooltip text="Expandir para visualização completa" />
               </tooltip>
            </Button>
            <ComboBox fx:id="ownerFilterCompact"
                      prefWidth="100"
                      promptText="Filtro"
                      styleClass="compact-combo"
                      style="-fx-font-size: 10px;"/>
         </children>
      </HBox>

      <!-- Search field -->
      <HBox alignment="CENTER_LEFT" spacing="5.0">
         <children>
            <TextField fx:id="searchField" promptText="Buscar termo..." HBox.hgrow="ALWAYS" styleClass="compact-search" />
            <Button fx:id="tibetanSearchButton" text="བོད་" onAction="#openTibetanSearchInput" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;">
               <tooltip>
                  <Tooltip text="Abrir entrada de teclado tibetano" />
               </tooltip>
            </Button>
            <Button fx:id="clearButton" text="✕" onAction="#clearSearch" styleClass="compact-button" />
         </children>
      </HBox>

      <!-- Results list - compact -->
      <ListView fx:id="resultsListView" VBox.vgrow="ALWAYS" prefHeight="200.0" styleClass="compact-list" />

      <!-- Load more button -->
      <Button fx:id="loadMoreButton" text="Carregar mais" onAction="#loadMoreResults" styleClass="compact-toggle-button" maxWidth="Infinity" visible="false" />

      <!-- Diacritic Helper Toggle Button -->
      <Button fx:id="toggleDiacriticsButton" text="Mostrar Diacríticos" onAction="#toggleDiacritics" styleClass="compact-toggle-button" maxWidth="Infinity" />

      <!-- Diacritic Helper Panel (collapsible) -->
      <VBox fx:id="diacriticBox" spacing="3.0" styleClass="compact-term-display" managed="false" visible="false">
         <padding>
            <Insets top="5.0" right="5.0" bottom="5.0" left="5.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="5.0">
               <children>
                  <Label text="Diacríticos:" styleClass="compact-detail" />
                  <ToggleButton fx:id="sanskritToggle" text="SKT" onAction="#toggleSanskritMode" styleClass="compact-button" prefWidth="45.0" selected="true">
                     <tooltip>
                        <Tooltip text="Diacríticos Sânscritos" />
                     </tooltip>
                  </ToggleButton>
                  <ToggleButton fx:id="chineseToggle" text="CH" onAction="#toggleChineseMode" styleClass="compact-button" prefWidth="45.0">
                     <tooltip>
                        <Tooltip text="Pinyin Chinês" />
                     </tooltip>
                  </ToggleButton>
                  <TextField fx:id="diacriticSearchField" promptText="Digite letra..." prefWidth="100.0" styleClass="compact-search" />
               </children>
            </HBox>
            <ScrollPane fitToWidth="true" prefHeight="60.0" styleClass="compact-list">
               <content>
                  <FlowPane fx:id="diacriticPanel" hgap="3.0" vgap="3.0" prefWrapLength="300.0" />
               </content>
            </ScrollPane>
         </children>
      </VBox>

      <!-- Selected term display area -->
      <VBox styleClass="compact-term-display" spacing="8.0">
         <padding>
            <Insets top="10.0" right="5.0" bottom="10.0" left="5.0" />
         </padding>
         <children>
            <!-- Source term - on one line with label -->
            <HBox alignment="CENTER_LEFT" spacing="5.0" fx:id="sourceBox" managed="false" visible="false">
               <children>
                  <Label text="Termo:" styleClass="compact-detail" minWidth="60.0" />
                  <Label fx:id="sourceLabel" text="" styleClass="compact-term-text" HBox.hgrow="ALWAYS" wrapText="true">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Label>
                  <Button fx:id="copySourceButton" text="📋" onAction="#copySource" styleClass="compact-button" prefWidth="35.0" prefHeight="25.0" minWidth="35.0" minHeight="25.0">
                     <tooltip>
                        <Tooltip text="Copiar termo original" />
                     </tooltip>
                  </Button>
               </children>
            </HBox>

            <!-- Target term - on one line with label -->
            <HBox alignment="CENTER_LEFT" spacing="5.0" fx:id="targetBox" managed="false" visible="false">
               <children>
                  <Label text="Tradução:" styleClass="compact-detail" minWidth="60.0" />
                  <Label fx:id="targetLabel" text="" styleClass="compact-term-text" HBox.hgrow="ALWAYS" wrapText="true">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Label>
                  <Button fx:id="copyTargetButton" text="📋" onAction="#copyTarget" styleClass="compact-button" prefWidth="35.0" prefHeight="25.0" minWidth="35.0" minHeight="25.0">
                     <tooltip>
                        <Tooltip text="Copiar tradução" />
                     </tooltip>
                  </Button>
               </children>
            </HBox>

            <!-- Translation -->
            <Label fx:id="translationLabel" text="" styleClass="compact-translation" wrapText="true" />

            <!-- Additional info (collapsible) with scroll -->
            <VBox fx:id="detailsBox" spacing="3.0" managed="false" visible="false">
               <children>
                  <Separator />
                  <TextArea fx:id="detailsTextArea" editable="false" styleClass="compact-detail" wrapText="true" prefHeight="150.0" maxHeight="200.0" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>

            <!-- Open link button (for PDFs and Audio) - appears when link is detected -->
            <Button fx:id="openLinkButton" text="🔗 Abrir Link" onAction="#openMediaLink" styleClass="compact-toggle-button" maxWidth="Infinity" managed="false" visible="false" />

            <!-- Toggle details button -->
            <Button fx:id="toggleDetailsButton" text="Ver mais detalhes" onAction="#toggleDetails" styleClass="compact-toggle-button" maxWidth="Infinity" />
         </children>
      </VBox>

      <!-- Status label -->
      <Label fx:id="statusLabel" text="Digite um termo para buscar" styleClass="compact-status" />
   </children>
</VBox>
